# Recall AI 后端环境变量(复制为 .env 后填写)
DEBUG=true

# 数据库(SQLite 文件)
DATABASE_URL=sqlite:///./recall.db

# ChromaDB 向量库
CHROMA_DIR=./chroma_data
CHROMA_COLLECTION=questions
DEDUP_THRESHOLD=0.95

# DeepSeek API(可选;留空则在前端「设置」页配置,运行时生效)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60.0

# 上传目录
UPLOAD_DIR=./uploads
